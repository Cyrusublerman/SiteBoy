{
  "name": "siteboy-framework",
  "version": "4.0.0",
  "description": "SiteBoy Framework - Modern ES Module Architecture with Mathematical Precision",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:analyze": "vite build --mode analyze",
    "build:legacy": "vite build --legacy",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "node scripts/validate-compatibility.js",
    "scrape:fetch": "node tools/scrape/fetch.mjs",
    "scrape:clean": "node tools/scrape/clean.mjs",
    "scrape:paste": "node tools/scrape/paste-loop.mjs",
    "scrape:mine": "node tools/scrape/mine.mjs",
    "scrape:extract": "node tools/scrape/extract.mjs",
    "scrape:embed": "node tools/scrape/embed.mjs",
    "scrape:cluster": "node tools/scrape/cluster.mjs",
    "scrape:synth": "node tools/scrape/synth.mjs",
    "scrape:run": "node tools/scrape/fetch.mjs && node tools/scrape/clean.mjs && node tools/scrape/mine.mjs"
  },
  "keywords": [
    "ui",
    "components",
    "framework",
    "vga",
    "mathematical"
  ],
  "author": "SiteBoy Framework",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@mozilla/readability": "^0.6.0",
    "@testing-library/dom": "^10.4.1",
    "@vitejs/plugin-legacy": "^8.0.1",
    "hdbscan-ts": "^1.0.17",
    "jsdom": "^27.3.0",
    "mdast-util-from-markdown": "^2.0.3",
    "nerdfonts-web": "^1.0.1",
    "openai": "^6.37.0",
    "puppeteer": "^24.37.5",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.1",
    "turndown": "^7.2.4",
    "vite": "^8.0.5",
    "vitest": "^4.0.15",
    "zod": "^4.4.3"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.3",
    "jszip": "^3.10.1",
    "opentype.js": "^1.3.5",
    "woff2-encoder": "^2.0.0"
  }
}
